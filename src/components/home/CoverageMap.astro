---
/**
 * CoverageMap — the homepage hero's town network (corridor links + markers + labels), drawn
 * over the hero's county map.
 *
 * HONESTY RULE (design-system §6): an IDENTITY / coverage visual, NOT live network
 * topology. Towns sit at their real lat/lon, projected by `heroProject` into hero column
 * space — the same space src/assets/hero-map.svg is drawn in, so every marker lands on its
 * place on the map. The SVG is 1320×811 user units at 1:1 pixels; Hero.astro positions it
 * on the content column. Quiet by design: 1px links, small dots, small labels.
 */
import { towns, corridors, townById, heroProject } from '@config/coverage';

const at = (id: string) => {
  const t = townById(id);
  return t ? heroProject(t.lon, t.lat) : null;
};
const corridorPath = (ids: readonly string[]) =>
  ids
    .map(at)
    .filter((p) => p !== null)
    .map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`)
    .join(' ');

// Faint rings that give the Highway 4 chain some weight (static; the ping is the motion).
const halos: Record<
  string,
  { r: number; width: number; opacity: number; tone: 'brass' | 'green' }
> = {
  'bear-valley': { r: 14, width: 3, opacity: 0.3, tone: 'brass' },
  arnold: { r: 19, width: 4, opacity: 0.25, tone: 'brass' },
  murphys: { r: 23, width: 5, opacity: 0.08, tone: 'green' },
};

const markers = towns.map((t) => ({ ...t, ...heroProject(t.lon, t.lat), halo: halos[t.id] }));

const ariaLabel =
  'Service-area coverage map: Bear Valley, Dorrington, Arnold, Murphys (headquarters), Angels Camp, ' +
  'Columbia, and Sonora, linked along the Highway 4 and Highway 49 corridors.';
---

<div class="coverage" role="img" aria-label={ariaLabel}>
  <svg class="coverage__svg" width="1320" height="811" viewBox="0 0 1320 811" aria-hidden="true">
    <g class="coverage__links">
      {
        corridors.map((c) => (
          <path
            d={corridorPath(c.path)}
            class:list={['coverage__link', { 'is-dashed': c.kind === 'dashed' }]}
          />
        ))
      }
    </g>

    {
      markers.map(
        (m) =>
          m.halo && (
            <circle
              class={`coverage__halo coverage__halo--${m.halo.tone}`}
              cx={m.x.toFixed(1)}
              cy={m.y.toFixed(1)}
              r={m.halo.r}
              stroke-width={m.halo.width}
              stroke-opacity={m.halo.opacity}
            />
          )
      )
    }

    {
      markers.map((m, i) => (
        <g
          class={`coverage__marker coverage__marker--${m.role}`}
          transform={`translate(${m.x.toFixed(1)} ${m.y.toFixed(1)})`}
        >
          <circle class="coverage__ping" r="7" style={`animation-delay:${(i * 0.4).toFixed(2)}s`} />
          <circle class="coverage__dot" r="6.5" />
          <text
            class="coverage__label"
            x={m.labelSide === 'left' ? -14 : 13}
            y="3.5"
            text-anchor={m.labelSide === 'left' ? 'end' : 'start'}
          >
            {m.name}
            {m.role === 'hq' ? ' · HQ' : ''}
          </text>
        </g>
      ))
    }
  </svg>
</div>

<style>
  .coverage__svg {
    display: block;
    max-width: none; /* never scaled: its units are column pixels, like the map's */
    overflow: visible;
  }

  .coverage__link {
    fill: none;
    stroke: var(--brand-green);
    stroke-width: 1;
    opacity: 0.45;
  }
  .coverage__link.is-dashed {
    stroke: var(--brand-brass);
    stroke-dasharray: 3 4;
    opacity: 0.75;
  }

  .coverage__halo {
    fill: none;
  }
  .coverage__halo--brass {
    stroke: var(--brand-brass);
  }
  .coverage__halo--green {
    stroke: var(--brand-green);
  }

  .coverage__dot {
    stroke: var(--surface-hero);
    stroke-width: 1.5;
  }
  .coverage__marker--hq .coverage__dot {
    fill: var(--brand-green);
  }
  .coverage__marker--town .coverage__dot {
    fill: var(--brand-brass);
  }
  .coverage__marker--hub .coverage__dot {
    fill: var(--signal-orange);
  }

  .coverage__ping {
    fill: none;
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: coverage-ping var(--ping-duration) ease-out infinite;
  }
  .coverage__marker--hq .coverage__ping {
    stroke: var(--brand-green);
  }
  .coverage__marker--town .coverage__ping {
    stroke: var(--brand-brass);
  }
  .coverage__marker--hub .coverage__ping {
    stroke: var(--signal-orange);
  }

  @keyframes coverage-ping {
    0% {
      transform: scale(0.7);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* SVG user units are screen pixels here (the SVG is never scaled). The halo stroke keeps a
     label readable where it crosses a highway. */
  .coverage__label {
    font-family: var(--font-ui);
    font-size: 9.5px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--ink-strong);
    paint-order: stroke;
    stroke: var(--surface-hero);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .coverage__marker--hq .coverage__label {
    fill: var(--brand-green);
  }

  @media (prefers-reduced-motion: reduce) {
    .coverage__ping {
      animation: none;
      opacity: 0;
    }
  }
</style>
