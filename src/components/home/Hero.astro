---
/**
 * Hero — the homepage coverage band (design-system §6).
 * Left: brand lockup (mark + S.I.E.R.R.A + full-name definition), two-tone
 * headline, subhead, two buttons. Behind it, full bleed: a faint real map of the
 * Calaveras & Tuolumne foothills (src/assets/hero-map.svg — county tints, county lines,
 * state highways; regenerate with `npm run hero-map`) with the CoverageMap town network on
 * top at true geographic positions. Map and network share one coordinate system, the
 * centered 1320px column, so they stay aligned at any width; below 1320px the column pins
 * to the window's left edge and the right side crops. On tablet and below both are dropped.
 */
import Container from '../Container.astro';
import Logo from '../Logo.astro';
import Button from '../Button.astro';
import CoverageMap from './CoverageMap.astro';
import HeroMap from '../../assets/hero-map.svg';
import { home } from '@config/content';
import { legend } from '@config/coverage';
import { site } from '@config/site';

const { hero } = home;
const roleClass: Record<string, string> = {
  hq: 'legend__dot--hq',
  town: 'legend__dot--town',
  hub: 'legend__dot--hub',
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    {
      /* Background, bottom to top: green wash, county map, a fade that keeps the copy legible,
        then the town network. All anchored to the 1320px column (see --hero-col). */
    }
    <div class="hero__glow" aria-hidden="true"></div>
    <HeroMap class="hero__map" aria-hidden="true" focusable="false" />
    <div class="hero__fade" aria-hidden="true"></div>
    <div class="hero__mesh">
      <CoverageMap />
    </div>

    <Container class="hero__container">
      <div class="hero__message">
        <div class="hero__lockup">
          <Logo variant="mark" height={46} class="hero__emblem" />
          <div class="hero__lockup-text">
            <span class="hero__wordmark">{site.name}</span>
            <span class="hero__defn">{site.legalName}</span>
          </div>
        </div>

        <h1 id="hero-title" class="hero__headline">
          <span class="hero__headline-muted">{hero.headlineMuted}</span>
          <span class="hero__headline-strong">{hero.headlineStrong}</span>
        </h1>
        <p class="hero__subhead">{hero.subhead}</p>
        <div class="hero__ctas">
          <Button variant="primary" href={hero.primaryCta.href} arrow>
            {hero.primaryCta.label}
          </Button>
          <Button variant="secondary" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </Button>
        </div>
      </div>
    </Container>
  </div>

  <div class="hero__legend">
    <Container>
      <div class="legend">
        <ul class="legend__roles">
          {
            legend.map((l) => (
              <li class="legend__item">
                <span class:list={['legend__dot', roleClass[l.role]]} aria-hidden="true" />
                {l.label}
              </li>
            ))
          }
        </ul>
        <span class="legend__region">Calaveras &amp; Tuolumne foothills</span>
      </div>
    </Container>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--surface-hero);
    border-bottom: var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* The stage holds the background layers and the copy. Every layer is anchored to the
     1320px content column; --hero-col is that column's left edge, pinned to the window's
     left edge when the window is narrower than the column (the right side crops). */
  .hero__stage {
    --hero-col: max(0px, 50% - 660px);
    position: relative;
    min-height: 811px;
    display: flex;
    align-items: center;
  }

  /* The single permitted decorative gradient — a barely-visible green wash. */
  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      70% 90% at 70% 25%,
      color-mix(in srgb, var(--brand-green) 6%, transparent),
      transparent 65%
    );
  }

  /* The map's viewBox origin is offset so its user units ARE column pixels: it runs 1100px
     past each side of the column (no visible edge up to ~3500px windows) and 200px past the
     top and bottom of the stage. Never scaled. */
  .hero :global(.hero__map) {
    position: absolute;
    left: calc(var(--hero-col) - 1100px);
    top: -200px;
    max-width: none; /* base.css caps images/SVGs at 100% — this one must not scale */
    pointer-events: none;
  }
  .hero :global(.hero-map__calaveras) {
    fill: var(--brand-green);
    fill-opacity: 0.075;
  }
  .hero :global(.hero-map__tuolumne) {
    fill: var(--brand-brass);
    fill-opacity: 0.12;
  }
  .hero :global(.hero-map__borders) {
    stroke: var(--map-county-line);
    stroke-width: 1;
  }
  .hero :global(.hero-map__roads) {
    stroke: var(--map-road);
    stroke-width: 3.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .hero :global(.hero-map__shield rect) {
    fill: var(--map-road);
    stroke: var(--map-shield-line);
    stroke-width: 1;
  }
  .hero :global(.hero-map__shield text) {
    font-family: var(--font-ui);
    font-size: 8px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    fill: var(--map-shield-text);
    text-anchor: middle;
  }
  .hero :global(.hero-map__county-name) {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 26px;
    fill: var(--map-place);
    text-anchor: middle;
  }

  /* Keeps the copy legible over the map: solid parchment from the window's left edge to
     column x 500, clear by column x 800. Part of the hero background, like the wash. */
  .hero__fade {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: calc(var(--hero-col) + 800px);
    pointer-events: none;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--surface-hero) 93%, transparent) calc(100% - 300px),
      transparent 100%
    );
  }

  .hero__mesh {
    position: absolute;
    top: 0;
    left: var(--hero-col);
    pointer-events: none;
  }

  .hero :global(.hero__container) {
    position: relative;
    z-index: 1;
    padding-block: var(--space-9);
  }

  .hero__message {
    max-width: 560px;
  }

  /* Brand lockup: mark + wordmark + the full-name definition (Jay's ask). */
  .hero__lockup {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .hero__lockup-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .hero__wordmark {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--ink-strong);
  }
  .hero__defn {
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--brand-brass-text);
    max-width: 44ch;
  }

  .hero__headline {
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .hero__headline-muted,
  .hero__headline-strong {
    display: block;
  }
  .hero__headline-muted {
    color: var(--ink-muted);
    max-width: 14ch;
  }
  .hero__headline-strong {
    color: var(--ink-strong);
  }

  .hero__subhead {
    margin-top: var(--space-5);
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--ink-body);
  }

  .hero__ctas {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Legend strip pinned to the bottom of the band (explains the map markers) */
  .hero__legend {
    position: relative;
    z-index: 1;
    border-top: var(--border);
    background: color-mix(in srgb, var(--surface-hero) 55%, var(--surface-page));
    padding-block: var(--space-4);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-secondary);
  }

  .legend__roles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legend__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .legend__dot--hq {
    background: var(--brand-green);
  }
  .legend__dot--town {
    background: var(--brand-brass);
  }
  .legend__dot--hub {
    background: var(--signal-orange);
  }

  .legend__region {
    color: var(--brand-brass-text);
  }

  /* Tablet and below: drop the map, network and legend; keep the brand + message. */
  @media (max-width: 900px) {
    .hero__stage {
      min-height: 0;
    }
    .hero :global(.hero__map),
    .hero__fade,
    .hero__mesh,
    .hero__legend {
      display: none;
    }
    .hero :global(.hero__container) {
      padding-block: var(--space-8);
    }
  }
</style>
