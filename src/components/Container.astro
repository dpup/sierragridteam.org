---
/**
 * Container — centered max-width wrapper with the standard page gutters. One width
 * site-wide (`--container-max`), so page content lines up with the nav and footer.
 */
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
  id?: string;
}

const { as: Tag = 'div', class: className, id } = Astro.props;
---

<Tag class:list={['container', className]} id={id}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
