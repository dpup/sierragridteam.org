---
/**
 * MeshMap — the /mesh topology map frame: the MapLibre canvas, a calm "reading the mesh"
 * panel until the graph lands, and the required basemap + data attribution.
 *
 * This is the FRAME only. The map itself is built in `src/lib/mesh-map.ts` from a browser
 * `<script>` in the page (maplibre must never be imported from Astro frontmatter), and the
 * SSR state here is an honest placeholder — nothing about the mesh is baked at build time.
 */
import { BASEMAP_ATTRIBUTION } from '@lib/basemap';
import { mesh } from '@config/content';
---

<figure class="meshmap" data-mesh-map>
  <div class="meshmap__canvas" data-mesh-canvas>
    {
      /* Shown when JS/WebGL can't run, and until the layers are added. The roster in the
        panel carries the same information as a list, so this is a degradation, not a
        dead end. */
    }
    <p class="meshmap__fallback" data-mesh-fallback>{mesh.mapFallback}</p>
  </div>

  <div class="meshmap__loading" data-mesh-loading role="status" aria-live="polite">
    <span class="meshmap__dot" aria-hidden="true"></span>
    <p class="meshmap__loadtext">{mesh.loading}</p>
  </div>

  <figcaption class="meshmap__foot">
    <ul class="meshmap__key" aria-label="Map key">
      <li>
        <span class="meshmap__node meshmap__node--corridor" aria-hidden="true"></span>Corridor node
      </li>
      <li>
        <span class="meshmap__node meshmap__node--neighbour" aria-hidden="true"></span>Neighbour
      </li>
      <li><span class="meshmap__line" aria-hidden="true"></span>Observed relay</li>
    </ul>
    <p class="meshmap__attrib">{BASEMAP_ATTRIBUTION} · {mesh.attribution}</p>
  </figcaption>
</figure>

<style>
  .meshmap {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 420px;
    margin: 0;
    background: var(--surface-hero);
  }

  .meshmap__canvas {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .meshmap__fallback {
    max-width: 42ch;
    padding: var(--space-6);
    text-align: center;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--ink-secondary);
  }

  .meshmap__loading {
    position: absolute;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background: var(--surface-hero);
    transition:
      opacity var(--transition),
      visibility 0s linear var(--transition);
  }
  /* `visibility: hidden` as well as opacity: an opacity-0 element is still in the
     accessibility tree, so axe flags its (now invisible) text for contrast and screen
     readers would still announce this role="status" region after it's done. The delayed
     visibility transition lets the fade finish first. */
  .meshmap__loading[data-hidden='true'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Slow blink — the one sanctioned motion for a "working on it" state. */
  .meshmap__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand-green);
    animation: meshmap-blink var(--blink-duration) ease-in-out infinite;
  }

  @keyframes meshmap-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .meshmap__dot {
      animation: none;
    }
  }

  .meshmap__loadtext {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-secondary);
  }

  /* Basemap credit is a licence requirement, so it sits in the flow of the figure rather
     than in a floating MapLibre control (attributionControl is off). */
  /* Key and credit share one row when there's room and stack when there isn't. The credit
     is long, so without wrapping it squeezed the key into a cramped vertical column and got
     itself clipped at intermediate widths — the map column's width, not the viewport's, is
     what runs out, so a media query can't catch this. */
  .meshmap__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-2) var(--space-4);
    background: var(--surface-page);
    border-top: var(--border);
  }
  .meshmap__key {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    color: var(--ink-secondary);
  }
  .meshmap__key li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .meshmap__node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .meshmap__node--corridor {
    background: var(--brand-green);
    box-shadow: 0 0 0 1.5px var(--brand-brass);
  }
  .meshmap__node--neighbour {
    border: 1px solid var(--ink-muted);
  }
  .meshmap__line {
    width: 20px;
    height: 2px;
    background: var(--brand-green);
    opacity: 0.65;
  }
  .meshmap__attrib {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    color: var(--ink-muted);
  }
</style>
