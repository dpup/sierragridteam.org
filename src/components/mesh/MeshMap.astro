---
/**
 * MeshMap — the /mesh topology map frame: the MapLibre canvas, a calm "reading the mesh"
 * panel until the graph lands, and the required basemap credit.
 *
 * This is the FRAME only. The map itself is built in `src/lib/mesh-map.ts` from a browser
 * `<script>` in the page (maplibre must never be imported from Astro frontmatter), and the
 * SSR state here is an honest placeholder — nothing about the mesh is baked at build time.
 *
 * The credit is a licence requirement, so it is plain visible text in the map's bottom-left
 * corner, styled like the page — not a MapLibre attribution control. The map's key is the
 * client-rendered legend under the figure (`mesh-view.ts`).
 */
import { mesh } from '@config/content';
import { BASEMAP_ATTRIBUTION } from '@lib/basemap';
---

<figure class="meshmap map-frame" data-mesh-map>
  <div class="meshmap__canvas" data-mesh-canvas>
    {
      /* Shown when JS/WebGL can't run, and until the layers are added. The roster in the
        panel carries the same information as a list, so this is a degradation, not a
        dead end. */
    }
    <p class="meshmap__fallback" data-mesh-fallback>{mesh.mapFallback}</p>
  </div>

  <div class="meshmap__loading" data-mesh-loading role="status" aria-live="polite">
    <span class="meshmap__dot" aria-hidden="true"></span>
    <p class="meshmap__loadtext">{mesh.loading}</p>
  </div>

  <figcaption class="meshmap__attrib">{BASEMAP_ATTRIBUTION}</figcaption>
</figure>

<style>
  .meshmap {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: clamp(480px, 70vh, 760px);
    margin: var(--space-6) 0 0;
    background: var(--surface-hero);
    border: var(--border);
    /* The card and its leader are positioned inside the figure; nothing may spill out. */
    overflow: hidden;
  }

  .meshmap__attrib {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-3);
    z-index: 1;
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    color: var(--ink-muted);
    pointer-events: none;
  }

  .meshmap__canvas {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .meshmap__fallback {
    max-width: 42ch;
    padding: var(--space-6);
    text-align: center;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--ink-secondary);
  }

  .meshmap__loading {
    position: absolute;
    inset: 0;
    z-index: var(--z-overlay);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background: var(--surface-hero);
    transition:
      opacity var(--transition),
      visibility 0s linear var(--transition);
  }
  /* `visibility: hidden` as well as opacity: an opacity-0 element is still in the
     accessibility tree, so axe flags its (now invisible) text for contrast and screen
     readers would still announce this role="status" region after it's done. The delayed
     visibility transition lets the fade finish first. */
  .meshmap__loading[data-hidden='true'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Slow blink — the one sanctioned motion for a "working on it" state. */
  .meshmap__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand-green);
    animation: meshmap-blink var(--blink-duration) ease-in-out infinite;
  }

  @keyframes meshmap-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .meshmap__dot {
      animation: none;
    }
  }

  .meshmap__loadtext {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-secondary);
  }
</style>
