---
/**
 * MeshSidebar — the /mesh info panel. An EMPTY SKELETON at build time: every number,
 * legend count and roster row is filled by the browser from the live mesh feed via
 * `src/lib/mesh-view.ts` (no feed data is fetched at build — docs/architecture/data-feed.md).
 *
 * The h1 lives here because the panel is the page's document header; the map beside it is
 * the figure. The collapse behaviour + layout live in the page (src/pages/mesh.astro).
 */
import Kicker from '../Kicker.astro';
import { mesh } from '@config/content';
import { externalLinks } from '@config/site';
---

<div class="mesh-sidebar mesh-view">
  <header class="mesh-sidebar__head">
    <Kicker>{mesh.kicker}</Kicker>
    <h1 class="mesh-sidebar__title">{mesh.heading}</h1>
    <p class="mesh-sidebar__intro">{mesh.intro}</p>

    <p class="mesh-sidebar__status">
      <span class="mesh-sidebar__pill" data-mesh-status-tone="pending" data-mesh-status>—</span>
      <span class="mesh-sidebar__sync" data-mesh-status-detail>{mesh.autoRefresh}</span>
    </p>
  </header>

  {/* Live tiles — the client replaces this node's contents wholesale on each refresh. */}
  <div data-mesh-tiles></div>

  <section class="mesh-sidebar__block" aria-labelledby="mesh-legend-heading">
    <h2 class="mesh-sidebar__h2" id="mesh-legend-heading">{mesh.legendHeading}</h2>
    <div data-mesh-legend></div>
  </section>

  <section class="mesh-sidebar__block" aria-labelledby="mesh-roster-heading">
    <h2 class="mesh-sidebar__h2" id="mesh-roster-heading">{mesh.rosterHeading}</h2>
    <p class="mesh-sidebar__note">{mesh.rosterHint}</p>
    <div data-mesh-roster></div>
  </section>

  <section class="mesh-sidebar__block" aria-labelledby="mesh-neighbour-heading">
    <h2 class="mesh-sidebar__h2" id="mesh-neighbour-heading">{mesh.neighbourHeading}</h2>
    <p class="mesh-sidebar__note">{mesh.neighbourNote}</p>
  </section>

  {
    /* Not a disclaimer in the legal sense — it's the honest reading of what an advert
      proves, and it stays visible rather than tucked behind a tooltip. */
  }
  <section class="mesh-sidebar__block" aria-labelledby="mesh-honesty-heading">
    <h2 class="mesh-sidebar__h2" id="mesh-honesty-heading">{mesh.honestyHeading}</h2>
    <p class="mesh-sidebar__note">{mesh.honestyNote}</p>
    <p class="mesh-sidebar__note">
      <a
        class="mesh-sidebar__link"
        href={externalLinks.meshcoreMap}
        target="_blank"
        rel="noopener external"
      >
        {mesh.meshcoreLabel}<span aria-hidden="true"> &#8599;</span>
      </a>
    </p>
  </section>
</div>

<style>
  .mesh-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-7) var(--space-6);
  }

  .mesh-sidebar__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h3);
  }

  .mesh-sidebar__intro {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--ink-body);
  }

  /* Status cluster: an honest tone chip + the freshness stamp. */
  .mesh-sidebar__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
  }
  .mesh-sidebar__pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: var(--border);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .mesh-sidebar__pill[data-mesh-status-tone='ok'] {
    color: var(--brand-green);
    border-color: var(--brand-green);
  }
  /* Stale and unknown both read muted-and-outlined — neither may look like a green tick. */
  .mesh-sidebar__pill[data-mesh-status-tone='stale'],
  .mesh-sidebar__pill[data-mesh-status-tone='unknown'] {
    color: var(--brand-brass-text);
    border-color: var(--brand-brass);
  }
  .mesh-sidebar__sync {
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .mesh-sidebar__h2 {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-secondary);
  }

  .mesh-sidebar__note {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--ink-secondary);
  }

  .mesh-sidebar__link {
    color: var(--brand-green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .mesh-sidebar__link:hover {
    text-decoration: none;
  }
</style>
