---
/**
 * /mesh — the mesh report. Like /live, this page renders its data ENTIRELY in the browser:
 * nothing about the network is baked at build time, so no stale topology or stale battery
 * can ship in the HTML. SSR is the layout, an empty skeleton and the map's "reading the mesh"
 * state; the client fills all of it.
 *
 * TWO selections, deliberately decoupled. The table and the map share one — "which repeater
 * am I looking at" — and it is also the page's `?node=` URL, so a view can be shared. The
 * chart has its own pinned trace — "which line am I following" — because isolating a curve
 * should not fly the map somewhere, and selecting a repeater should not blank six traces out
 * of the comparison the chart exists to make.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import MeshPanels from '@components/mesh/MeshPanels.astro';
import { mesh as copy } from '@config/content';
import { site } from '@config/site';
import '../styles/mesh.css';

const description =
  'Live status of the S.I.E.R.R.A LoRa / MeshCore mesh along the Ebbetts Pass corridor — ' +
  'which repeaters we are hearing, where their signal reaches, and how their batteries held ' +
  'up overnight.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${copy.heading} — ${site.name}`,
  url: `${site.url}/mesh`,
};
---

<BaseLayout title={copy.title} description={description} path="/mesh" schema={schema}>
  <MeshPanels />
</BaseLayout>

<script>
  // /mesh is live-only: fetch the topology + the monitor archive in the browser, render
  // every region, and refresh on an interval. maplibre is imported HERE (a client script),
  // never from Astro frontmatter.
  import { initMeshMap, type MeshMapHandle } from '../lib/mesh-map';
  import {
    fetchGlobalGraph,
    fetchMeshEvents,
    fetchRegionGraph,
    fetchTelemetry,
  } from '../lib/mesh-client';
  import { buildMeshView } from '../lib/mesh-view';
  import { renderMeshHistory, PLOT } from '../lib/mesh-history';
  import {
    linksToGeoJSON,
    MESH_WINDOW,
    type MeshEventsPage,
    type MeshGraph,
    type MeshRosterSort,
  } from '../lib/mesh';
  import {
    historyWindow,
    valueAt,
    HISTORY_METRIC_UNITS,
    type HistoryMetric,
    type TelemetrySeries,
  } from '../lib/mesh-telemetry';
  import { mesh as copy } from '../config/content';
  import { serviceAreaBounds } from '../config/coverage';
  import { escapeHtml as esc } from '../lib/format';
  import counties from '../assets/service-counties.json';

  const REFRESH_MS = 120_000;
  /** The archive moves slowly; re-fetch it on a refresh only once it is this old. */
  const TELEMETRY_MAX_AGE_MS = 10 * 60_000;

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);
  const figure = $('[data-mesh-map]');
  const loading = $('[data-mesh-loading]');
  const headlineEl = $('[data-mesh-headline]');
  const ledeEl = $('[data-mesh-lede]');
  const statsEl = $('[data-mesh-stats]');
  const legendEl = $('[data-mesh-legend]');
  const sortEl = $('[data-mesh-sort]');
  const rosterEl = $('[data-mesh-roster]');
  const historyIntroEl = $('[data-mesh-history-intro]');
  const historyTabsEl = $('[data-mesh-history-tabs]');
  const historyEl = $('[data-mesh-history]');

  let handle: MeshMapHandle | null = null;
  let graph: MeshGraph | null = null;
  let inflight: AbortController | null = null;
  let backdropLoaded = false;
  let events: MeshEventsPage['events'] | null = null;

  /** The monitor archive, keyed by public key. Empty until the deferred fetch lands. */
  let series = new Map<string, TelemetrySeries>();
  let telemetryAt = 0;

  // ---- view state ----
  /** Table + map + URL: the selected repeater. Seeded from a shared `?node=` link. */
  let selected: string | null = new URL(location.href).searchParams.get('node');
  /** Chart only: the trace pinned at full strength while the rest drop back. */
  let pinned: string | null = null;
  let sort: MeshRosterSort = 'links';
  let metric: HistoryMetric = 'battery';

  // ---- rendering ----

  function renderPanels(g: MeshGraph, nowMs: number) {
    const view = buildMeshView(g, MESH_WINDOW, nowMs, { selected, sort, series });
    if (headlineEl) headlineEl.innerHTML = view.html.headline;
    if (ledeEl) ledeEl.innerHTML = view.html.lede;
    if (statsEl) statsEl.innerHTML = view.html.stats;
    if (legendEl) legendEl.innerHTML = view.html.legend;
    if (sortEl) sortEl.innerHTML = view.html.sortTabs;
    if (rosterEl) rosterEl.innerHTML = view.html.roster;
    renderHistory(g, nowMs);
  }

  function renderHistory(g: MeshGraph, nowMs: number) {
    const h = renderMeshHistory(
      g.nodes.filter((n) => n.inRegion),
      series,
      { metric, pinned },
      nowMs
    );
    if (historyIntroEl) historyIntroEl.textContent = h.intro;
    if (historyTabsEl) historyTabsEl.innerHTML = h.tabs;
    if (historyEl) historyEl.innerHTML = h.body;
  }

  /** Honest failure: no stale topology, just what we know and where the data lives. */
  function renderFailure() {
    if (headlineEl) {
      headlineEl.innerHTML = `<span class="mesh-h1__lead">${esc(copy.failHeading)}</span>`;
    }
    if (ledeEl) ledeEl.textContent = copy.failBody;
    for (const el of [statsEl, legendEl, sortEl, rosterEl, historyTabsEl, historyEl]) {
      if (el) el.innerHTML = '';
    }
    if (historyIntroEl) historyIntroEl.textContent = '';
    loading?.setAttribute('data-hidden', 'true');
  }

  // ---- the live cycle ----

  async function load() {
    inflight?.abort();
    const ac = new AbortController();
    inflight = ac;
    try {
      const g = await fetchRegionGraph(MESH_WINDOW, ac.signal);
      if (ac.signal.aborted) return;
      graph = g;
      const now = Date.now();
      // A shared link to a repeater that is no longer in the corridor selects nothing.
      if (selected && !g.nodes.some((n) => n.inRegion && n.publicKey === selected)) {
        setSelected(null);
      }
      renderPanels(g, now);

      if (figure && !handle) {
        handle = initMeshMap(figure, {
          bounds: serviceAreaBounds,
          counties: counties as GeoJSON.FeatureCollection,
          // A pin click, Esc or a click on bare map changes the shared selection.
          onSelectNode: (key) => {
            setSelected(key);
            if (graph) renderPanels(graph, Date.now());
          },
        });
        handle?.onPanOut(loadBackdrop);
        if (selected) handle?.select(selected);
      }
      handle?.setGraph(g, MESH_WINDOW, now);
      loading?.setAttribute('data-hidden', 'true');
      void loadTelemetry();
    } catch (err) {
      if ((err as Error)?.name === 'AbortError') return;
      renderFailure();
    }
  }

  /**
   * The monitor archive, one request per MONITORED repeater, after the corridor has painted.
   * Deferred because it is N round-trips for a section below the fold, and re-fetched only
   * once it is TELEMETRY_MAX_AGE_MS old rather than on every two-minute refresh.
   */
  async function loadTelemetry() {
    if (!graph) return;
    const keys = graph.nodes.filter((n) => n.inRegion && n.admin).map((n) => n.publicKey);
    if (!keys.length || Date.now() - telemetryAt < TELEMETRY_MAX_AGE_MS) return;
    try {
      const { from, to } = historyWindow(Date.now());
      const fetched = await fetchTelemetry(
        keys,
        new Date(from),
        new Date(to),
        new AbortController().signal
      );
      series = new Map(fetched.map((s) => [s.publicKey, s]));
      telemetryAt = Date.now();
      if (graph) renderPanels(graph, Date.now());
    } catch {
      // Non-fatal: the header, the map and the table are already correct without it. The
      // chart keeps saying it has nothing to draw, which is true.
    }
  }

  /** Lazily pull the whole observed mesh in as a faint backdrop. Once, best-effort. */
  async function loadBackdrop() {
    if (backdropLoaded || !graph || !handle) return;
    backdropLoaded = true;
    try {
      const known = new Set(graph.nodes.map((n) => n.publicKey));
      const ac = new AbortController();
      const roster = events ?? (await fetchMeshEvents(ac.signal));
      events = roster;
      const global = await fetchGlobalGraph(roster, known, ac.signal);
      handle.setBackdrop(global.nodes, linksToGeoJSON(global.links, Date.now()));
    } catch {
      // Context, not the subject — a failure leaves the corridor map exactly as it was.
      backdropLoaded = false;
    }
  }

  // ---- selection: one piece of state, the table, the map and the URL read it ----

  function setSelected(key: string | null) {
    selected = key;
    const url = new URL(location.href);
    if (key) url.searchParams.set('node', key);
    else url.searchParams.delete('node');
    history.replaceState(history.state, '', url);
  }

  const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)');

  /** A table row: select (or let go of) its repeater, and bring the map into view. */
  function selectFromTable(key: string) {
    const next = selected === key ? null : key;
    setSelected(next);
    handle?.select(next);
    if (graph) renderPanels(graph, Date.now());
    if (next) {
      figure?.scrollIntoView({
        behavior: reduceMotion?.matches ? 'auto' : 'smooth',
        block: 'center',
      });
    }
  }

  rosterEl?.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('[data-mesh-row]');
    if (row?.dataset.meshRow) selectFromTable(row.dataset.meshRow);
  });
  const hoverRow = (e: Event) => {
    const row = (e.target as HTMLElement)?.closest<HTMLElement>('[data-mesh-row]');
    handle?.highlight(row?.dataset.meshRow ?? null);
  };
  rosterEl?.addEventListener('mouseover', hoverRow);
  rosterEl?.addEventListener('focusin', hoverRow);
  rosterEl?.addEventListener('mouseleave', () => handle?.highlight(null));

  sortEl?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mesh-sort]');
    if (!b?.dataset.meshSort || !graph) return;
    sort = b.dataset.meshSort as MeshRosterSort;
    renderPanels(graph, Date.now());
  });

  historyTabsEl?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-mesh-metric]');
    if (!b?.dataset.meshMetric || !graph) return;
    metric = b.dataset.meshMetric as HistoryMetric;
    renderHistory(graph, Date.now());
  });

  // ---- the chart: click pins a trace, hover lifts and names it ----

  historyEl?.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    const key =
      el.closest<HTMLElement>('[data-mesh-key]')?.dataset.meshKey ??
      el.closest<SVGPathElement>('[data-mesh-hit]')?.dataset.meshHit;
    if (!key || !graph) return;
    pinned = pinned === key ? null : key;
    renderHistory(graph, Date.now());
  });

  /** How far from the pointer a sample may sit and still be the answer. */
  const HINT_TOLERANCE_MS = 45 * 60_000;

  /** Back to the pinned state (or the resting bundle) once the pointer leaves. */
  function clearHint() {
    const chart = $('.mesh-chart');
    if (!chart) return;
    for (const path of chart.querySelectorAll<SVGPathElement>('.mesh-chart__line')) {
      const mine = path.dataset.meshSeries === pinned;
      path.classList.toggle('mesh-chart__line--lift', pinned != null && mine);
      path.classList.toggle('mesh-chart__line--mute', pinned != null && !mine);
    }
    chart.querySelector('[data-mesh-hint]')?.setAttribute('hidden', '');
    chart.querySelector('.mesh-chart__cursor')?.setAttribute('hidden', '');
  }

  /**
   * Lift one trace and dim the rest — a class toggle on the paths, never a re-render, which
   * would fight the mouse. With a pointer, also name the reading AT that moment; outside the
   * tolerance (a monitor outage) say nothing rather than reach across the gap.
   */
  function showHint(key: string, ev?: PointerEvent) {
    const chart = $('.mesh-chart');
    const svg = chart?.querySelector<SVGSVGElement>('.mesh-chart__svg');
    const hint = chart?.querySelector<HTMLElement>('[data-mesh-hint]');
    if (!chart || !svg || !hint) return;
    for (const path of chart.querySelectorAll<SVGPathElement>('.mesh-chart__line')) {
      const mine = path.dataset.meshSeries === key;
      path.classList.toggle('mesh-chart__line--lift', mine);
      path.classList.toggle('mesh-chart__line--mute', !mine);
    }
    const name =
      chart.querySelector<SVGPathElement>(`[data-mesh-hit="${CSS.escape(key)}"]`)?.dataset.name ??
      '';
    const box = svg.getBoundingClientRect();
    let label = '';
    let left = box.width / 2;
    let top = box.height / 3;
    const s = series.get(key);
    const from = Number(svg.dataset.from);
    const to = Number(svg.dataset.to);
    if (ev && s && Number.isFinite(from) && Number.isFinite(to)) {
      const fx = Math.max(0, Math.min(1, (ev.clientX - box.left) / box.width));
      const found = valueAt(s, metric, from + fx * (to - from), HINT_TOLERANCE_MS);
      if (found) label = `${Math.round(found.v)}${HISTORY_METRIC_UNITS[metric]}`;
      left = ev.clientX - box.left;
      top = ev.clientY - box.top;
      const cursor = chart.querySelector<SVGLineElement>('.mesh-chart__cursor');
      if (cursor) {
        cursor.setAttribute('x1', String(fx * PLOT.W));
        cursor.setAttribute('x2', String(fx * PLOT.W));
        cursor.removeAttribute('hidden');
      }
    }
    hint.innerHTML =
      `<span>${esc(name)}</span>` +
      (label ? `<span class="mesh-chart__hint-value">${esc(label)}</span>` : '');
    hint.style.left = `${left}px`;
    hint.style.top = `${Math.max(0, top)}px`;
    hint.removeAttribute('hidden');
  }

  historyEl?.addEventListener('pointermove', (e) => {
    const hit = (e.target as HTMLElement)?.closest<SVGPathElement>('[data-mesh-hit]');
    if (hit?.dataset.meshHit) showHint(hit.dataset.meshHit, e);
    else if (!(e.target as HTMLElement)?.closest('[data-mesh-key]')) clearHint();
  });
  historyEl?.addEventListener('pointerleave', clearHint);
  // The legend is the other end of the same affordance, by pointer or by keyboard.
  for (const type of ['mouseover', 'focusin'] as const) {
    historyEl?.addEventListener(type, (e) => {
      const key = (e.target as HTMLElement)?.closest<HTMLElement>('[data-mesh-key]');
      if (key?.dataset.meshKey) showHint(key.dataset.meshKey);
    });
  }
  historyEl?.addEventListener('focusout', clearHint);

  load();
  setInterval(load, REFRESH_MS);
</script>
