# S.I.E.R.R.A site — environment variables (all OPTIONAL).
# Copy to `.env` for local overrides. The site builds fine with none of these set.

# Override the live data feed base URL.
#   builds / preview  → https://data.sierragridteam.org/api/v1
#   `astro dev`       → /grid-api, a same-origin proxy to the same upstream (astro.config.mjs).
# The dev proxy exists because The Grid's CORS allowlist only names the production origin
# and http://localhost:4321 — without it, dev from any other hostname fails every live
# region. Set this only to point somewhere else entirely, e.g. a Grid running locally.
# PUBLIC_ vars are exposed to client-side islands.
# PUBLIC_GRID_API_BASE=http://localhost:8080/api/v1

# Public contact email shown on /contact and in structured data.
# Defaults to info@sierragridteam.org if unset.
PUBLIC_CONTACT_EMAIL=info@sierragridteam.org
