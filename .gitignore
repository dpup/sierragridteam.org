# build output
dist/
.astro/

# dependencies
node_modules/
# `make test` runs the unit tests through bun; npm + package-lock.json remain the
# source of truth for dependencies, so bun's lockfile must never be committed.
bun.lock

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/screenshots/**/*-actual.png
tests/screenshots/**/*-diff.png
# LIVE=1 screenshots (real feed data; non-deterministic, for eyeballing only)
tests/screenshots/_live/

# generated (kept out of source; produced by `make gen-assets` / build)
# NOTE: committed favicons/og live in public/ and are NOT ignored.

# env & local
.env
.env.*
!.env.example
*.local

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# News-desk auto-tune output (review, never commit)
.github/prompts/*.candidate.md
